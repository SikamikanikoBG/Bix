# Server name (DNS record pointing at this VM). Internal name + internal certificate: see deploy/BANK-AZURE.md.
BIX_DOMAIN=bix.example.eu
POSTGRES_PASSWORD=change-me-long-random

# Session signing key (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
BIX_AUTH_SECRET_KEY=

# --- Corporate network ---------------------------------------------------------------
# HTTPS_PROXY=http://proxy.bank.local:8080
# NO_PROXY=localhost,127.0.0.1,db,bix,.bank.local
# Login to Azure (Entra ID), Azure OpenAI and Speech go through the proxy unless they are private endpoints.

# --- Microsoft Entra ID app (or managed identity) used by the Azure services below ----
# BIX_AZURE_TENANT_ID=
# BIX_AZURE_CLIENT_ID=
# BIX_AZURE_CLIENT_SECRET=
# BIX_AZURE_CERTIFICATE_PATH=/data/bix-app.pem     # instead of a secret (copy the PEM into the volume)
# BIX_AZURE_MANAGED_IDENTITY=true                  # on an Azure VM: no secrets

# --- Speech to text: Azure AI Speech in an EU region -----------------------------------
BIX_STT_PROVIDER=azure
BIX_STT_AZURE_ENDPOINT=https://<your-speech-resource>.cognitiveservices.azure.com
AZURE_SPEECH_KEY=
# BIX_STT_AZURE_AUTH=entra                          # with the Entra app above instead of the key

# --- Minutes and "Ask Bix": Azure OpenAI ---------------------------------------------
BIX_LLM_PROVIDER=azure_openai
BIX_LLM_AZURE_ENDPOINT=https://<your-openai-resource>.openai.azure.com
BIX_LLM_AZURE_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_KEY=
# BIX_LLM_AZURE_AUTH=entra
# --- or Claude: anthropic (API key) or bedrock (eu-central-1)
# BIX_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Storage: the Docker volume by default; or Azure Blob / S3 ------------------------
# BIX_STORAGE_BACKEND=azure_blob
# BIX_STORAGE_AZURE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# BIX_STORAGE_AZURE_CONTAINER=bix
# BIX_AZURE_STORAGE_CONNECTION_STRING=              # instead of Entra ID

# --- Single sign-on to the portal (Microsoft Entra ID) --------------------------------
# BIX_AUTH_OIDC_ENABLED=true
# BIX_AUTH_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# BIX_AUTH_OIDC_CLIENT_ID=
# BIX_OIDC_CLIENT_SECRET=
# BIX_AUTH_OIDC_ALLOWED_DOMAINS=bank.bg

# --- Sending the minutes: the bank's SMTP relay ... -----------------------------------
# BIX_SMTP_HOST=smtp-relay.bank.local
# BIX_SMTP_PORT=25
# BIX_SMTP_STARTTLS=true
# BIX_SMTP_SENDER=bix@bank.bg
# BIX_SMTP_REPLY_TO=it@bank.bg
# BIX_SMTP_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# --- ... or Microsoft 365 (also gives the room calendars)
# BIX_GRAPH_ENABLED=true
# BIX_GRAPH_SENDER_MAILBOX=bix@bank.bg
